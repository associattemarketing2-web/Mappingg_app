# ---------------------------------------------------------------------------
# Mappingg mobile app — environment variables
#
# Copy this file to .env.local (git-ignored) and edit it:
#     Copy-Item .env.example .env.local
#
# EVERY variable here is PUBLIC: EXPO_PUBLIC_* values are compiled into the app
# and anyone can read them from the APK. Never put database URLs, AUTH_SECRET,
# API keys, SMTP passwords or any other server secret in this file.
# ---------------------------------------------------------------------------

# Base URL of the existing Mappingg website/API (no trailing slash).
#   Production / staging:     https://www.mappingg.com
#   Android emulator + local: http://10.0.2.2:3000      (emulator's alias for your PC)
#   Physical phone + local:   http://192.168.x.x:3000   (your PC's Wi-Fi IP; start the
#                             website with:  npx next dev -H 0.0.0.0)
# http:// is accepted only by development builds; preview/production must be https://.
EXPO_PUBLIC_API_BASE_URL=https://www.mappingg.com

# Label shown on the Account screen so testers know which backend they are on.
# One of: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Optional. The website's live map also copies each enquiry to a Google Sheet via
# a public Apps Script URL (it is in the website's public JavaScript). Leave empty
# to skip; the enquiry is saved on the server either way.
EXPO_PUBLIC_LEAD_SHEET_WEBHOOK_URL=

# Build flavour read by app.config.ts (not bundled). EAS sets it per profile.
APP_VARIANT=development
