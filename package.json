{
  "name": "mapping-app",
  "version": "1.0.0",
  "description": "Mappingg mobile app (Expo / React Native). Standalone project — talks to the existing Mappingg API over HTTPS.",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "check:deps": "expo install --check",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:env": "node scripts/check-env.mjs",
    "export:android": "expo export --platform android --output-dir dist",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:isolation && npm run check:env && npm run check:deps",
    "build:dev": "npx eas-cli@latest build --profile development --platform android",
    "build:apk": "npx eas-cli@latest build --profile preview --platform android",
    "build:prod": "npx eas-cli@latest build --profile production --platform android",
    "build:ios": "npx eas-cli@latest build --profile production --platform ios",
    "smoke:api": "node scripts/smoke-api.mjs",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/android/",
      "/ios/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  }
}
